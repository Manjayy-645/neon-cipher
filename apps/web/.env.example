# Public Supabase project URL; replace with the project for this environment.
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL_HERE

# Public anonymous key; safe to expose to the browser, but replace per environment.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# SERVER ONLY. Never prefix this value with NEXT_PUBLIC_ or expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# One of: local, staging, production.
NEXT_PUBLIC_APP_ENV=local

NEXT_PUBLIC_FEATURE_MAP=true
NEXT_PUBLIC_FEATURE_RIG=true
NEXT_PUBLIC_FEATURE_MARKET=true
NEXT_PUBLIC_FEATURE_COMMS=true
NEXT_PUBLIC_FEATURE_DUEL=true
NEXT_PUBLIC_FEATURE_SETTINGS=true
NEXT_PUBLIC_FEATURE_DEV_OVERLAY=true
